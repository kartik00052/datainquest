# --- Postgres ---
POSTGRES_USER=daginquest
POSTGRES_PASSWORD=daginquest
POSTGRES_DB=daginquest
DATABASE_URL=postgresql://daginquest:daginquest@postgres:5432/daginquest

# --- Ollama (pick a model you have the hardware for) ---
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b

# --- Airflow (verify the image tag exists before first run) ---
AIRFLOW_IMAGE=apache/airflow:3.1.0
AIRFLOW_BASE_URL=http://airflow:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin

# --- API security ---
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Agent behaviour ---
CONFIDENCE_THRESHOLD=0.6
DEDUPE_COOLDOWN_MINUTES=30
